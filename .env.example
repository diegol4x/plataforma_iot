# Secrets de l'aplicació
JWT_SECRET=genera-la-amb-el-següent-comandament # python -c "import secrets; print(secrets.token_urlsafe(32))"

# Broker MQTT
MQTT_USERNAME=lliure-a-la-teua-elecció
MQTT_PASSWORD=genera-la-amb-el-següent-comandament # python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL
POSTGRES_USER=lliure-a-la-teua-elecció
POSTGRES_PASSWORD=genera-la-amb-el-següent-comandament # python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=iot_monitoring

# Per a executar fora de Docker (pytest, scripts). Dins de Compose el sobreescriu el del compose.
DATABASE_URL=postgresql+psycopg://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/iot_monitoring